# Copiá este archivo como .env.local y completá con los datos de tu proyecto
# (Supabase > Project Settings > API). Las mismas variables van en Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Sirve la "publishable key" (sb_publishable_...) o la "anon key". Es pública:
# la protección real son las políticas de acceso de la tabla.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta ("secret key", sb_secret_..., o la "service_role"). Solo la usa el servidor
# para crear los accesos de las CM. Nunca le pongas NEXT_PUBLIC ni la compartas.
SUPABASE_SECRET_KEY=
# Clave de OpenAI para leer comprobantes de Uber con IA. Solo la usa el servidor.
OPENAI_API_KEY=
# Opcional: otro modelo con visión (por defecto gpt-6-luna, el más económico).
# OPENAI_RECEIPT_MODEL=
# Notificaciones push (Web Push). Se generan con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
# Secreto con el que Supabase llama al despachador de avisos (el mismo va en el Vault de Supabase).
CRON_SECRET=
